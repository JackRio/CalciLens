{
  "name": "ct-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "CT / segmentation mask viewer desktop app",
  "main": "electron/main.js",
  "scripts": {
    "build:client": "cd client && npm run build",
    "start": "electron .",
    "app": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ctviewer.app",
    "productName": "CT Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "extraResources": [
      { "from": "server", "to": "server", "filter": ["**/*", "!__pycache__"] },
      { "from": ".venv", "to": ".venv" }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
